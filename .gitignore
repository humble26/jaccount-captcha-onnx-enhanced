# ---- Python 虚拟环境（125 MB，绝不上传） ----
.venv/
venv/
__pycache__/
*.pyc

# ---- 依赖与工具缓存 ----
node_modules/
.pytest_cache/

# ---- 大体积第三方二进制（可用脚本重新下载，见 tools/fetch_assets.py） ----
# ORT 运行时 JS：570 KB，含在 vm_dump/ort.min.js，可由 npm 取得
vm_dump/ort.min.js
# 扩展构建产物里的 wasm：10.9 MB，由 npm 的 onnxruntime-web 取得
extension-build/**/assets/ort-wasm-simd.wasm

# ---- 打包产物（体积大且可由脚本重建） ----
*.zip

# ---- 扩展构建产物：整体由 extension-src/build.py 重建，不入库 ----
# 这样模型只保留 vm_dump/nn_model.onnx 一份，避免 1.1 MB 的重复提交
extension-build/

# ---- 调试中间产物：对照图 / 盲测页面 / 反混淆字符串 ----
vm_dump/blind2/
vm_dump/blind3/
vm_dump/webcheck/
vm_dump/blind_sheet.png
vm_dump/raw_strings.txt
vm_dump/raw_strings2.txt
vm_dump/backbone_feats.npz
# 复审/调试过程产生的联络表与 logits 导出（可由 analysis/_audit_*.py 重新生成）
vm_dump/audit_sheets/
# 本地一次性运维脚本（路径清理、归档打包等），与项目本身无关
vm_dump/_local/

# ---- 预处理与 Tesseract 消融的对照图（580 张，可由脚本重建） ----
# 评测只需要 samples/ + samples2/ + holdout/（220 张人工标注）
# 与 new300/（300 张已核对样本），其余为中间对照，不进仓库。
vm_dump/all_A_original/
vm_dump/all_B_bin156/
vm_dump/hold_A_original/
vm_dump/hold_B_bin156/
vm_dump/tess_A_original/
vm_dump/tess_B_prepared/
vm_dump/ablation/

# ---- 从浏览器导出的**他人**用户脚本，不属于本项目 ----
# （调试时用于确认加载顺序，涉及第三方作者版权，不随本项目分发）
vm_dump/00_*.user.js
vm_dump/01_*.user.js
vm_dump/02_*.user.js
vm_dump/03_*.user.js
vm_dump/04_*.user.js

# ---- 第三方参考实现副本：不随本项目分发 ----
# 这些是调试时下载来逐行比对的他人源码，没有附带许可声明，
# 原样收录进公开仓库有版权风险。README 里给出上游地址即可。
# 需要本地比对时自行下载到该目录（脚本会读它，但仓库不含它）。
vm_dump/ref/

# ---- 实验脚本的 stdout 记录与源码切片导出（脚本可重跑，属中间产物） ----
vm_dump/*_out.txt
vm_dump/*_src.txt
vm_dump/*_funcs.txt
vm_dump/sampling_plan.json
vm_dump/refactor_eval.json

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地工作区数据（不是临时缓存，但属本地状态，不入库） ----
.workbuddy/
